<div class="devise-auth-wrapper">
  <div class="card shadow-sm border-0 devise-auth-card">
    <div class="card-body p-4">

      <div class="text-center mb-4">
        <h2 class="fw-bold mb-1">
          <span class="text-primary"; style="color:#b02a55;font-style: italic;">Dayspring Shopline</span>🛍
        </h2>
        <p class="text-muted mb-0">
          <%= render "devise/shared/links" %>
        </p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

        <div class="mb-3">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email,
                class: "form-control",
                placeholder: "you@example.com" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, class: "form-label" %>
          <%= f.password_field :password,
                class: "form-control",
                placeholder: "••••••••" %>
        </div>

        <div class="d-grid mt-3">
          <%= f.submit "Log in", class: "btn btn-primary py-2" %>
        </div>

      <% end %>

    </div>
  </div>
</div>
