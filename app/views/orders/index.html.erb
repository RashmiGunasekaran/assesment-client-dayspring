<h1>Orders</h1>

<table class="table table-bordered">
  <thead>
    <tr>
      <th>Order ID</th>
      <th>Status</th>
      <th>Total Price</th>
    </tr>
  </thead>
  <tbody>
    <% @orders.each do |order| %>
      <tr>
        <td>
          <%= link_to order.id, order_path(order) %>
        </td>
        <td><%= order.status %></td>
        <td><%= order.total_price %></td>
      </tr>
    <% end %>
  </tbody>
</table>