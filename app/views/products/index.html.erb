<!-- Page Title -->
<div class="page-header">
  <h2>Products</h2>
</div>

<!-- Product Card -->
<div class="product-card">

  <!-- Top Controls -->
  <div class="card-header">
    <div class="search-box">
      <i class="bi bi-search"></i>
      <input type="text" placeholder="Search...">
    </div>

    <div class="header-actions">
      <button class="btn-light">
        <i class="bi bi-funnel"></i> Sort
      </button>

      <button class="btn-light">
        <i class="bi bi-filter"></i> Filter
      </button>

      <%= link_to "+ Add Product", new_product_path, class: "btn-primary" %>
    </div>
  </div>

  <!-- Table -->
  <table class="custom-table">
    <thead>
      <tr>
        <th>PRODUCT</th>
        <th>CATEGORY</th>
        <th>STATUS</th>
        <th>STOCK</th>
        <th>PRICE</th>
        <th>ACTION</th>
      </tr>
    </thead>

    <tbody>
      <% @products.each do |product| %>
        <tr>
          <td class="product-cell">
            <div class="product-info">
              <div class="product-img"></div>
              <%= link_to product.name, product_path(product), class: "product-name" %>
            </div>
          </td>

          <td><%= product.vendor.name %></td>

          <td>
            <% if product.inventory_count > 100 %>
              <span class="badge in-stock">In Stock</span>
            <% elsif product.inventory_count > 0 %>
              <span class="badge coming-soon">Low Stock</span>
            <% else %>
              <span class="badge out-stock">Out of Stock</span>
            <% end %>
          </td>

          <td><%= product.inventory_count %></td>
          <td>$<%= product.price %></td>

          <td class="action-icons">
            <i class="bi bi-pencil"></i>
            <i class="bi bi-trash"></i>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

</div>

<style>

.page-header h2 {
  font-weight: 600;
  margin-bottom: 20px;
}

.product-card {
  background: #ffffff;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20px;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f3f4f6;
  padding: 6px 12px;
  border-radius: 8px;
}

.search-box input {
  border: none;
  background: transparent;
  outline: none;
  margin-left: 6px;
}

.header-actions {
  display: flex;
  gap: 10px;
}

.btn-light {
  background: #f3f4f6;
  border: none;
  padding: 6px 12px;
  border-radius: 8px;
  cursor: pointer;
}

.btn-primary {
  background: #3b82f6;
  color: white;
  padding: 6px 14px;
  border-radius: 8px;
  text-decoration: none;
}

.custom-table {
  width: 100%;
  border-collapse: collapse;
}

.custom-table th {
  text-align: left;
  font-size: 12px;
  color: #6b7280;
  padding-bottom: 12px;
}

.custom-table td {
  padding: 12px 0;
  border-top: 1px solid #f1f1f1;
}

.product-cell {
  display: flex;
  align-items: center;
}

.product-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.product-img {
  width: 40px;
  height: 40px;
  background: #e5e7eb;
  border-radius: 8px;
}

.product-name {
  text-decoration: none;
  color: #111827;
  font-weight: 500;
}

.badge {
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 500;
}

.in-stock {
  background: #dcfce7;
  color: #16a34a;
}

.out-stock {
  background: #fee2e2;
  color: #dc2626;
}

.coming-soon {
  background: #fef3c7;
  color: #ca8a04;
}

.action-icons i {
  margin-right: 10px;
  cursor: pointer;
  color: #6b7280;
}

</style>