
<div class="mb-4">
  <h2>Welcome, <%= current_user.name.titleize  || "Guest" %></h2>
  <p class="text-muted">
    Use the menu on the left to explore the application.
  </p>
</div>

<h1>Products</h1>

<table class="table table-bordered">
  <thead>
    <tr>
      <th>Name</th>
      <th>Price</th>
      <th>Inventory</th>
      <th>Vendor</th>
      <th>Place Order</th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td>
          <%= link_to product.name, product_path(product) %>
        </td>
        <td><%= product.price %></td>
        <td><%= product.inventory_count %></td>
        <td><%= product.vendor.name %></td>
        <td><%= link_to "Place order", place_order_path(product) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>