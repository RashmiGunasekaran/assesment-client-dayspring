<aside class="text-black vh-100 p-3" style="width: 250px;background-color: #f1eaec;">
  <div class="bg-pink">
  <h4 class="mb-4">Dashboard</h4>

  <ul class="nav flex-column gap-2">

    <!-- Common -->
    <li class="nav-item">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-luggage-fill" viewBox="0 0 16 16">
  <path d="M2 1.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5V5h.5A1.5 1.5 0 0 1 8 6.5V7H7v-.5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .5.5H4v1H2.5v.25a.75.75 0 0 1-1.5 0v-.335A1.5 1.5 0 0 1 0 13.5v-7A1.5 1.5 0 0 1 1.5 5H2zM3 5h2V2H3z"/>
  <path d="M2.5 7a.5.5 0 0 1 .5.5v5a.5.5 0 0 1-1 0v-5a.5.5 0 0 1 .5-.5m10 1v-.5A1.5 1.5 0 0 0 11 6h-1a1.5 1.5 0 0 0-1.5 1.5V8H8v8h5V8zM10 7h1a.5.5 0 0 1 .5.5V8h-2v-.5A.5.5 0 0 1 10 7M5 9.5A1.5 1.5 0 0 1 6.5 8H7v8h-.5A1.5 1.5 0 0 1 5 14.5zm9 6.5V8h.5A1.5 1.5 0 0 1 16 9.5v5a1.5 1.5 0 0 1-1.5 1.5z"/>
</svg>
      <%= link_to "Products", products_path, class: "nav-link text-black" %>
    </li>

    <li class="nav-item">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-check" viewBox="0 0 16 16">
  <path d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m1.679-4.493-1.335 2.226a.75.75 0 0 1-1.174.144l-.774-.773a.5.5 0 0 1 .708-.708l.547.548 1.17-1.951a.5.5 0 1 1 .858.514M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0M8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4"/>
  <path d="M8.256 14a4.5 4.5 0 0 1-.229-1.004H3c.001-.246.154-.986.832-1.664C4.484 10.68 5.711 10 8 10q.39 0 .74.025c.226-.341.496-.65.804-.918Q8.844 9.002 8 9c-5 0-6 3-6 4s1 1 1 1z"/>
</svg>
      <%= link_to "Vendors", vendors_path, class: "nav-link text-black" %>
    </li>
    
    <li class="nav-item d-inline">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cart4" viewBox="0 0 16 16">
  <path d="M0 2.5A.5.5 0 0 1 .5 2H2a.5.5 0 0 1 .485.379L2.89 4H14.5a.5.5 0 0 1 .485.621l-1.5 6A.5.5 0 0 1 13 11H4a.5.5 0 0 1-.485-.379L1.61 3H.5a.5.5 0 0 1-.5-.5M3.14 5l.5 2H5V5zM6 5v2h2V5zm3 0v2h2V5zm3 0v2h1.36l.5-2zm1.11 3H12v2h.61zM11 8H9v2h2zM8 8H6v2h2zM5 8H3.89l.5 2H5zm0 5a1 1 0 1 0 0 2 1 1 0 0 0 0-2m-2 1a2 2 0 1 1 4 0 2 2 0 0 1-4 0m9-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2m-2 1a2 2 0 1 1 4 0 2 2 0 0 1-4 0"/>
</svg>
      <span><%= link_to "Orders", orders_path, class: "nav-link text-black" %></span>
    </li>

    <!-- Customer -->
    <% if current_user.customer? %>
      <li class="nav-item mt-3 text-uppercase small text-muted">
        <span class="text-black"><strong>Customer</strong></span>
      </li>
       
      <li class="nav-item">
        <div class="row">
        <div class="col-1">  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bag-heart" viewBox="0 0 16 16">
  <path fill-rule="evenodd" d="M10.5 3.5a2.5 2.5 0 0 0-5 0V4h5zm1 0V4H15v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V4h3.5v-.5a3.5 3.5 0 1 1 7 0M14 14V5H2v9a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1M8 7.993c1.664-1.711 5.825 1.283 0 5.132-5.825-3.85-1.664-6.843 0-5.132"/>
</svg></div>
        <div class="col"><%= link_to "My Wishlist", wishlists_path, class: "nav-link text-black" %></div>
        </div>
      </li>
    <% end %>

    <!-- Vendor -->
    <% if current_user.vendor? %>
      <li class="nav-item mt-3 text-uppercase small text-muted">
        <span class="text-black"><strong>Vendor</strong></span>
      </li>

      <li class="nav-item">
        <%= link_to "My Products", products_path, class: "nav-link text-black" %>
      </li>
    <% end %>

    <!-- Admin -->
    <% if current_user.admin? %>
      <li class="nav-item mt-3 text-uppercase small text-muted">
        <span class="text-black"><strong>Admin</strong></span>
      </li>
     
      <li class="nav-item">
        <%= link_to "Admin Products", admin_products_path, class: "nav-link text-black" %>
      </li>

      <li class="nav-item">
        <%= link_to "Admin Vendors", admin_vendors_path, class: "nav-link text-black" %>
      </li>
    <% end %>

  </ul>
</div>
</aside>