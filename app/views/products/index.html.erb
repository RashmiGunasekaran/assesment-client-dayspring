<h1>Products</h1>

<table class="table table-bordered">
  <thead>
    <tr>
      <th>Name</th>
      <th>Price</th>
      <th>Inventory</th>
      <th>Vendor</th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td>
          <%= link_to product.name, product_path(product) %>
        </td>
        <td><%= product.price %></td>
        <td><%= product.inventory_count %></td>
        <td><%= product.vendor.name %></td>
      </tr>
    <% end %>
  </tbody>
</table>