<h2>Low Stock Products</h2>

<table class="table">
  <thead>
    <tr>
      <th>Product Name</th>
      <th>Vendor</th>
      <th>Inventory Count</th>
    </tr>
  </thead>

  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.name %></td>
        <td><%= product.vendor.name %></td>
        <td><%= product.inventory_count %></td>
      </tr>
    <% end %>
  </tbody>
</table>