
<div class="mb-4">
  <h2>Welcome, <%= current_user.role  || "Guest" %></h2>
  <p class="text-muted">
    Use the menu on the left to explore the application.
  </p>
</div>

<h1>Products</h1>

<table class="table table-bordered">
  <thead>
    <tr>
      <th>Name</th>
      <th>Price</th>
      <th>Inventory</th>
      <th>Vendor</th>
    </tr>
  </thead>
  <tbody>
   <%if current_user.role == "customer"%>
    <% @products.each do |product| %>
      <tr>
        <%if product.inventory_count > 10 %>
        <td>
          <%= link_to product.name, product_path(product) %>
        </td>
        <td><%= product.price %></td>
        <td><%= product.inventory_count%></td>
        <td><%= product.vendor.name %></td>
        <% end %>
      </tr>
       <% end %>
       <% else %>
    
    <% @products.each do |product| %>
      <tr>

        <td>
          <%= link_to product.name, product_path(product) %>
        </td>
       
        
        <td><%= product.price %></td>
        <td><%= product.inventory_count%></td>

        <td><%= product.vendor.name %></td>


    <% end %>
    <% end %>
   

  </tbody>
</table>