<h1>Top Vendors</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Products</th>
      <th>Balance</th>
    </tr>
  </thead>
  <tbody>
    <% @vendors.each do |vendor| %>
      <tr>
        <td><%= vendor.name %></td>
        <td><%= vendor.products.count %></td>
        <td><%= vendor.balance %></td>
      </tr>
    <% end %>
  </tbody>
</table>
