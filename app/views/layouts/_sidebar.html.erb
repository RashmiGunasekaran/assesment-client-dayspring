<aside class="text-white vh-100 p-3" style="width: 250px;background-color: skyblue;">
  <div class="bg-pink">
  <h4 class="mb-4">Dashboard</h4>

  <ul class="nav flex-column gap-2">

    <!-- Common -->
    <li class="nav-item">
      <%= link_to "Products", products_path, class: "nav-link text-white h"%>
    </li>

    <li class="nav-item">
      <%= link_to "Vendors", vendors_path, class: "nav-link text-white h" %>
    </li>

    <li class="nav-item">
      <%= link_to "Orders", orders_path, class: "nav-link text-white h" %>
    </li>

    <!-- Customer -->
    <% if current_user.customer? %>
      <li class="nav-item mt-3 text-uppercase small text-muted">
        <span class="text-white">Customer</span>
      </li>

      <li class="nav-item">
        <%= link_to "My Wishlist", wishlists_path, class: "nav-link text-white " %>
      </li>
    <% end %>

    <!-- Vendor -->
    <% if current_user.vendor? %>
      <li class="nav-item mt-3 text-uppercase small text-muted">
        <span class="text-white">Vendor</span>
      </li>

      <li class="nav-item">
        <%= link_to "My Products", products_path, class: "nav-link text-white" %>
      </li>
    <% end %>

    <!-- Admin -->
    <% if current_user.admin? %>
      <li class="nav-item mt-3 text-uppercase small text-muted">
        <span class="text-white">Admin</span>
      </li>

      <li class="nav-item">
        <%= link_to "Admin Products", admin_products_path, class: "nav-link text-white h" %>
      </li>

      <li class="nav-item">
        <%= link_to "Admin Vendors", admin_vendors_path, class: "nav-link text-white h" %>
      </li>
    <% end %>

  </ul>
</div>
</aside>