<h2>Underperforming Products</h2>

<% if @underperforming_products.any? %>
  <table>
    <thead>
      <tr>
        <th>Product Name</th>
        <th>Price</th>
        <th>Inventory Count</th>
      </tr>
    </thead>
    <tbody>
      <% @underperforming_products.each do |product| %>
        <tr>
          <td><%= product.name %></td>
          <td><%= number_to_currency(product.price) %></td>
          <td><%= product.inventory_count %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No underperforming products found.</p>
<% end %>