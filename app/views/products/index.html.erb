
<div class="mb-4">
  <h2>Welcome, <%= current_user.name.titleize  || "Guest" %></h2>
  <p class="text-muted">
    Use the menu on the left to explore the application.
  </p>
</div>

<h1>Products</h1>

<table class="table table-striped table-hover">
  <thead>
    <tr>
      <th>Name</th>
      <th>Price</th>
      <th>Inventory</th>
      <th>Vendor</th>
      <th>Place Order</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td>
          <%= link_to product.name, product_path(product), class: "linktext" %>
        </td>
        <td> <%= "$" %> <%= product.price %></td>
        <td><%= product.inventory_count %></td>
        <td><%= product.vendor.name %></td>
        <td><%= link_to "Place order", place_order_path(product), class: "place_order_btn" %></td>
        <td>
          <% if product.inventory_count > 9 %>
            <%= content_tag(:span, "In stock", class: "instock") %>
          <% elsif product.inventory_count > 0 && product.inventory_count <= 9 %>
            <%= content_tag(:span, "Less in stock(order now)", class: "lowinstock") %>
          <% else %>
            <%= content_tag(:span, "Out of stock", class: "outofstock") %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>