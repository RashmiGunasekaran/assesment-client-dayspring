<h1>Orders</h1>
<%=notice %>
<div class="m-5 text-red"> <%= notice %></div>
<table class="table table-bordered my-5">
  <thead>
    <tr>
      <th>Order ID</th>
      <th>Status</th>
      <th>Total Price</th>
    </tr>
  </thead>
  <tbody>
    <% @orders.each do |order| %>
      <tr>
        <td>
          <span class="order-link-wrapper">
            <%= check_box_tag "order_ids[]", order.id %>
            <%= link_to order.id, order_path(order), class: "unstyled-link" %>
          </span>

          <%#= link_to order.id, order_path(order) , class: "unstyle" %>
        </td>
        <% if order.status == "pending" %>
           <td>
           <div class="row"><div class="col-6"> <%= order.status %> </div>
           <div class="col-6"><%=button_to "cancel order", cancelled_order_order_path(order, customer_id: order.customer_id)%> </div>
           </div></td>
        <% else %>
            <td><%= order.status %></td>
        <% end %>
        <td><%= order.total_price %></td>
      </tr>
    <% end %>
  </tbody>
</table>